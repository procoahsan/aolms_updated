# Copy to server/.env and supply your project's real credentials.
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Use the host, port and username from your Supabase database connection settings.
# Leave DB_HOST empty to derive the direct database host from SUPABASE_URL.
DB_HOST=
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=postgres

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
JWT_SECRET=
